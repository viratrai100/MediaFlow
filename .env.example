# ==============================================
# Social Media Video Downloader - Root Environment Template
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/social_media_downloader

# Rate Limiting & Abuse Prevention
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=30      # Max requests per IP within window

# Media Processing & Temp Storage
TEMP_STORAGE_PATH=./server/temp
MAX_DOWNLOAD_CONCURRENCY=5
TEMP_FILE_TTL_MS=3600000        # Cleanup temporary files after 1 hour (in ms)
MAX_MEDIA_FILE_SIZE_MB=500      # Max size limit for single stream processing

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
