# ==============================================
# Backend Server Environment Variables
# ==============================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# Frontend Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/social_media_downloader

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30

# Media Processing & Temp Storage
TEMP_STORAGE_PATH=./temp
MAX_DOWNLOAD_CONCURRENCY=5
TEMP_FILE_TTL_MS=3600000
MAX_MEDIA_FILE_SIZE_MB=500

# FFmpeg Path (leave empty if ffmpeg is in system PATH)
FFMPEG_PATH=
FFPROBE_PATH=
