# ==============================================
# Backend Server Environment Variables
# ==============================================

# Server Port and Environment (Render sets PORT automatically)
PORT=5000
NODE_ENV=production

# Frontend Client Origin (for CORS)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://mediaflow-fdjz.onrender.com

# Database Connection (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/social_media_downloader?retryWrites=true&w=majority

# JWT Auth Secret
JWT_SECRET=super_secret_jwt_key_social_stream_downloader_2026
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000

# Media Processing & Temp Storage
TEMP_STORAGE_PATH=./temp
MAX_DOWNLOAD_CONCURRENCY=10
TEMP_FILE_TTL_MS=3600000
MAX_MEDIA_FILE_SIZE_MB=500

# FFmpeg & FFprobe Binary Paths
# (Leave empty on Render/Linux to auto-use bundled @ffmpeg-installer or system PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Python Executable Path (Optional - defaults to python3 on Linux, python on Windows)
PYTHON_PATH=

# YouTube Server-Side Authentication / PO-Token (Optional - strictly kept on server)
# YOUTUBE_COOKIE_PATH=./temp/cookies.txt
# YOUTUBE_COOKIES=
# YOUTUBE_PO_TOKEN=
